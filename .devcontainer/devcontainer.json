{
  "name": "OmniRoot Agent",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [5173, 5001, 8080],
  "portsAttributes": {
    "5173": {
      "label": "OmniRoot Frontend",
      "onAutoForward": "openBrowser"
    },
    "5001": {
      "label": "OmniRoot API",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "OmniRoot Code Server",
      "onAutoForward": "silent"
    }
  },
  "postAttachCommand": "bash -lc 'nohup bash .devcontainer/start-omniroot.sh >/tmp/omniroot-start.log 2>&1 </dev/null &'"
}
